# ── Commands ─────────────────────────────────
def cmd_diag():
    NL = "\n"
    o = f"─── SISTEMA ───{NL}"
    o += f"Hostname: {run('hostname').strip()}  |  Kernel: {os.uname().release}  |  "
    o += f"OS: {run('grep PRETTY_NAME /etc/os-release|cut -d= -f2|tr -d \"\\\"\"').strip()}{NL}"
    o += f"Uptime: {run('uptime -p|sed \"s/up //\"').strip()}  |  Load: {run('cat /proc/loadavg|cut -d\" \" -f1-3').strip()}{NL}"
    o += f"{NL}─── CPU ───{NL}"
    o += f"  {run('grep -m1 \"model name\" /proc/cpuinfo|cut -d: -f2').strip()} ({run('grep -c ^processor /proc/cpuinfo').strip()} núcleos){NL}"
    o += f"{NL}─── MEMÓRIA ───{NL}"
    o += run('free -h').strip() + NL
    o += f"{NL}─── DISCO ───{NL}"
    o += run('df -h /|tail -1|awk \'{printf "%s - %s de %s (%s livres)",$1,$3,$2,$4}\'') + NL
    o += f"{NL}─── TEMPERATURAS ───{NL}"
    o += run('sensors 2>/dev/null|grep -E \"Core|Package|temp1|Tctl\"|head -5').strip() + NL
    gpu = run('nvidia-smi --query-gpu=name,temperature.gpu --format=csv,noheader 2>/dev/null') if has('nvidia-smi') else run('lspci|grep -iE \"vga|3d|display\"|cut -d: -f3-')
    o += f"{NL}─── GPU ───{NL}{gpu.strip()}{NL}"
    o += f"{NL}─── WIFI ───{NL}"
    o += (run(f'iw dev {WIFI} link 2>/dev/null') if WIFI else '(sem WiFi)') + NL
    o += f"{NL}─── PORTAS ───{NL}"
    o += run("ss -tlnp|awk 'NR>1{print $5, $1}'|head -12") + NL
    o += f"{NL}─── SERVIÇOS ───{NL}"
    o += run("systemctl --failed|grep 'loaded failed'||echo 'Nenhum'") + NL
    o += f"{NL}─── ZRAM ───{NL}"
    o += run('zramctl 2>/dev/null||echo inativo') + NL
    o += f"{NL}─── BOOT ───{NL}"
    o += run('systemd-analyze 2>/dev/null').strip() + NL
    return o

def cmd_smart():
    if not has('smartctl'): return "smartctl não instalado"
    m = run(f"smartctl -i {DISK} 2>/dev/null|grep 'Device Model'|cut -d: -f2|xargs").strip()
    h = run(f"smartctl -H {DISK} 2>/dev/null|grep 'SMART overall-health'|cut -d: -f2|xargs").strip()
    t = run(f"smartctl -A {DISK} 2>/dev/null|awk '/Temperature_Celsius/{{print $10}}'").strip()
    a = run(f"smartctl -A {DISK} 2>/dev/null|sed -n '8,25p'").strip()
    return f"Modelo: {m}\nSaúde: {h}\nTemperatura: {t or 'N/A'}°C\n\nSMART:\n{a}"

def cmd_rede():
    NL = "\n"
    o = f"─── INTERFACES ───{NL}"
    o += run('ip -br addr|grep -v lo') + NL
    o += f"{NL}─── PORTAS ───{NL}"
    o += run("ss -tlnp|awk 'NR>1{split($5,a,\":\"); print a[length(a)]}'|sort -n|uniq|head -20") + NL
    o += f"{NL}─── FIREWALL ───{NL}"
    o += run('ufw status|head -5 2>/dev/null||echo n/a') + NL
    o += f"{NL}─── PING ───{NL}"
    c1 = run("ping -c2 -W2 1.1.1.1 2>/dev/null|awk '/rtt/{print $4}'|cut -d/ -f1").strip() or "—"
    c2 = run("ping -c2 -W2 8.8.8.8 2>/dev/null|awk '/rtt/{print $4}'|cut -d/ -f1").strip() or "—"
    o += f"Cloudflare: {c1} ms{NL}Google: {c2} ms{NL}"
    return o

def cmd_espaco():
    NL = "\n"
    o = f"─── PARTIÇÕES ───{NL}"
    o += run('df -h|grep -v tmpfs|grep -v udev') + NL
    o += f"{NL}─── TOP 15 PASTAS ───{NL}"
    o += run(f'du -sh {USER_HOME}/* --exclude=.cache 2>/dev/null|sort -rh|head -15') + NL
    return o

def cmd_seguranca():
    NL = "\n"; s = run("journalctl -u sshd -n20 --no-pager 2>/dev/null|grep -i 'failed\\|invalid'|tail -10") or "(sem registos)"
    o = f"─── SSH FALHADOS ───{NL}{s}{NL}"
