def acao_servicos():
    while True:
        header()
        print(f"  {C['B']}🔄  Serviços{C['n']}\n")
        opt = pick([
            ('l',"📋  Listar ativos"),
            ('e',"📋  Listar enabled"),
            ('s',"▶  Iniciar / ⏹  Parar / 🔄  Reiniciar"),
            ('d',"🔛  Ativar / 🔕  Desativar"),
        ], "")
        if opt=='l':
            out = run("systemctl list-units --type=service --state=running --no-pager 2>/dev/null")
            set_output(out); show_output(out)
        elif opt=='e':
            out = run("systemctl list-unit-files --type=service --state=enabled --no-pager 2>/dev/null")
