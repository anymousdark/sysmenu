                a = input("  Opção: ").strip()
                m = {'1':'enable','2':'disable'}
                if a in m: run(f"systemctl {m[a]} {s}", root=True); msg(f"✅ {s} {m[a]}d")
        else: break

def acao_autopilot():
    clear()
    if not confirm("Executar tudo? (update, logs, trim, zram, DNS, flatpak)"): return
    for t, fn in [
        ("📦  Atualizar", lambda: run_live(f"{D.pu} && {D.pup}", root=True)),
        ("🧽  Limpar cache", lambda: run_live(D.pc, root=True)),
        ("📜  Logs", lambda: run_live("journalctl --vacuum-size=100M", root=True)),
        ("💾  TRIM", lambda: run_live("fstrim -v /", root=True)),
        ("🗑  Kernels", kernels_cleanup),
        ("🧹  /tmp", lambda: run("rm -rf /tmp/* /var/tmp/* 2>/dev/null", root=True)),
        ("💾  Zram", lambda: (WIFI and run(f"iw dev {WIFI} set power_save off", root=True))),
        ("🌐  DNS", lambda: (SSID and run(f"nmcli con mod \"{SSID}\" ipv4.dns '1.1.1.1 8.8.8.8'"))),
        ("📦  Flatpak", lambda: (has('flatpak') and run("flatpak update -y", t=300))),
    ]:
        print(f"  {C['y']}→{C['n']} {t}..."); fn(); time.sleep(0.2)
    msg("✅ Auto-Pilot concluído!")

def acao_exportar():
    clear()
    outfile = f"{HOME}/sysmenu-diagnostico-{time.strftime('%Y%m%d-%H%M%S')}.txt"
    with open(outfile,'w') as f:
        f.write(f"Sys Menu - Diagnóstico\n{time.strftime('%Y-%m-%d %H:%M:%S')}\n{'='*50}\n\n")
        f.write(cmd_diag()+"\n"+cmd_smart()+"\n"+cmd_rede())
    print(f"\n  {C['g']}✅ Exportado:{C['n']} {outfile}")
    input()

