#!/usr/bin/env bash

# ──────────────────────────────────────────────
#   🛠  SYS MENU — v3.0
#   Diagnóstico + otimização do sistema
#   https://github.com/anymousdark/sysmenu
# ──────────────────────────────────────────────

# ── Auto-elevação para root ──────────────────
[ "$(id -u)" -ne 0 ] && exec sudo "$0" "$@"

# ── Config ────────────────────────────────────
TITLE="🛠  Sys Menu  —  v3.0"
WIFI=$(iw dev 2>/dev/null | awk '/Interface/{print $2}')
SSID=$(nmcli -t -f NAME con show --active 2>/dev/null | head -1)
DISK="/dev/sda"
[ ! -b "$DISK" ] && DISK="/dev/$(lsblk -ndo NAME 2>/dev/null | head -1)"

export TERM=${TERM:-xterm-256color}

has() { command -v "$1" &>/dev/null; }

msg()  { whiptail --title "$TITLE" --msgbox "$1" 20 70; }

# ── Menu principal ───────────────────────────
main_menu() {
  while true; do
    CHOICE=$(whiptail --title "$TITLE" --menu "\nEscolha uma opção:" 22 72 14 \
      "1"  "🔍  Diagnóstico completo" \
      "2"  "📶  WiFi — diagnóstico e otimização" \
      "3"  "💾  Zram — status e ativação" \
      "4"  "🛠   Serviços com falha" \
      "5"  "💽  Saúde do disco (SMART)" \
      "6"  "🌡   Temperaturas / sensores" \
      "7"  "📊  Memória e CPU" \
      "8"  "📝  Logs do sistema" \
      "9"  "⚡  Hardware (CPU/GPU/boot)" \
      "10" "🌐  Rede (portas, firewall, ping)" \
      "11" "🧹  Manutenção (update, limpeza)" \
      "12" "📁  Espaço em disco" \
      "13" "📋  Exportar diagnóstico" \
      "14" "🏁  Auto-pilot (tudo de uma vez)" \
      "0"  "❌  Sair" 3>&1 1>&2 2>&3)

    case $CHOICE in
      "")  echo "Bye!"; exit 0 ;;
      1)   diag_completo ;;
      2)   wifi_menu ;;
      3)   zram_menu ;;
      4)   servicos_falha ;;
      5)   disk_smart ;;
      6)   temperaturas ;;
      7)   mem_cpu ;;
      8)   logs_sistema ;;
      9)   hardware_info ;;
      10)  rede_menu ;;
      11)  manutencao ;;
      12)  espaco_disco ;;
      13)  exportar_diag ;;
      14)  auto_pilot ;;
      0)   echo "Bye!"; exit 0 ;;
    esac
  done
}

# ── Helpers ──────────────────────────────────
section() {
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  $1"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

capture() {
  local cmd="$*"
  eval "$cmd" 2>/dev/null || echo "(comando não disponível)"
}

show_output() {
  local label="$1"
  shift
  local out
  out=$("$@" 2>/dev/null)
  whiptail --title "$TITLE — $label" --scrolltext --msgbox "$out" 24 80
}

# ── 1 ────────────────────────────────────────
diag_completo() {
  {
    section "SISTEMA"
    echo "Hostname : $(hostname)"
    echo "Kernel   : $(uname -r)"
    echo "OS       : $(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')"
    echo "Uptime   : $(uptime -p | sed 's/up //')"
    echo "Load     : $(cat /proc/loadavg | cut -d' ' -f1-3)"

    section "CPU"
    grep -m1 "model name" /proc/cpuinfo | cut -d: -f2
    echo "Núcleos  : $(grep -c ^processor /proc/cpuinfo)"

    section "MEMÓRIA"
    free -h | awk 'NR==1{printf "%-8s %8s %8s %8s\n",$1,$2,$3,$4} NR==2{printf "%-8s %8s %8s %8s\n",$1,$2,$3,$4}'

    section "DISCO"
    df -h / | awk 'NR==2{printf "%s — %s de %s (%s livres)\n",$1,$3,$2,$4}'

    section "TEMPERATURAS"
    capture sensors

    section "GPU"
    if has nvidia-smi; then
      nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu --format=csv,noheader
    else
      lspci | grep -iE "vga|3d|display" | cut -d: -f3-
    fi

    section "WIFI"
    if [ -n "$WIFI" ]; then
      iw dev "$WIFI" link
      iw dev "$WIFI" station dump | grep signal
    else
      echo "(sem interface WiFi)"
    fi

    section "PORTAS A ESCUTAR"
    ss -tlnp | awk 'NR>1{print $5, $1}' | head -15

    section "SERVIÇOS COM FALHA"
    systemctl --failed | grep "loaded failed" || echo "Nenhum"

    section "ZRAM"
    zramctl || echo "Inativo"

    section "BOOT"
    systemd-analyze
    echo ""
    echo "Serviços mais lentos:"
    systemd-analyze blame | head -5
  } > /tmp/sysmenu-diag.txt

  whiptail --title "$TITLE — Diagnóstico Completo" --scrolltext \
    --msgbox "$(cat /tmp/sysmenu-diag.txt)" 24 80
}

# ── 2 ────────────────────────────────────────
wifi_menu() {
  [ -z "$WIFI" ] && { msg "Sem interface WiFi detectada."; return; }

  while true; do
    local info
    info=$(echo "Interface: $WIFI"; iw dev "$WIFI" link 2>/dev/null; \
           iw dev "$WIFI" station dump 2>/dev/null | grep -E "signal:|bitrate:|retries:|connected time:")

    CHOICE=$(whiptail --title "$TITLE — 📶 WiFi" --menu "$info" 20 72 5 \
      "1" "DNS → Cloudflare/Google" \
      "2" "Desligar power saving" \
      "3" "Escanear redes" \
      "0" "Voltar" 3>&1 1>&2 2>&3)

    case $CHOICE in
      1) nmcli con mod "$SSID" ipv4.dns "1.1.1.1 8.8.8.8"
         nmcli con down "$SSID" 2>/dev/null && nmcli con up "$SSID" 2>/dev/null
         msg "DNS alterado para 1.1.1.1 e 8.8.8.8 ✓" ;;
      2) iw dev "$WIFI" set power_save off
         msg "Power saving desligado ✓" ;;
      3) nmcli dev wifi rescan
         msg "Scan concluído. Use 'nmcli dev wifi list' para ver as redes." ;;
      0|"") return ;;
    esac
  done
}

# ── 3 ────────────────────────────────────────
zram_menu() {
  local status
  if zramctl 2>/dev/null | grep -q zram; then
    status=$(zramctl; echo ""; swapon --show)
    whiptail --title "$TITLE — 💾 Zram" --scrolltext --msgbox "$status" 20 70
  else
    if whiptail --title "$TITLE — 💾 Zram" --yesno "Zram está inativo.\n\nAtivar agora?" 10 50; then
      systemctl start dev-zram0.swap 2>/dev/null
      if zramctl | grep -q zram; then
        msg "✅ Zram ativado com sucesso!"
      else
        msg "❌ Falha. systemd-zram-generator instalado?"
      fi
    fi
  fi
}

# ── 4 ────────────────────────────────────────
servicos_falha() {
  local failed
  failed=$(systemctl --failed 2>/dev/null)
  if ! echo "$failed" | grep -q "failed"; then
    msg "✅ Nenhum serviço com falha."
    return
  fi

  whiptail --title "$TITLE — 🛠 Serviços com falha" --scrolltext --msgbox "$failed" 20 70

  if whiptail --title "Confirmar" --yesno "Desativar o serviço com falha?" 8 50; then
    local unit
    unit=$(echo "$failed" | awk '/loaded failed/{print $1}')
    [ -n "$unit" ] && systemctl disable --now "$unit" 2>/dev/null && msg "✅ $unit desativado"
  fi
}

# ── 5 ────────────────────────────────────────
disk_smart() {
  local model health temp attrib
  model=$(smartctl -i "$DISK" 2>/dev/null | grep "Device Model" | cut -d: -f2 | xargs)
  health=$(smartctl -H "$DISK" 2>/dev/null | grep "SMART overall-health" | cut -d: -f2 | xargs)
  temp=$(smartctl -A "$DISK" 2>/dev/null | awk '/Temperature_Celsius/{print $10}')
  attrib=$(smartctl -A "$DISK" 2>/dev/null | sed -n '7,25p')

  local out
  out="Modelo: $model\nSaúde: $health\nTemperatura: ${temp:-N/A}°C\n\nSMART Attributes:\n$attrib"

  whiptail --title "$TITLE — 💽 Disco" --scrolltext --msgbox "$out" 20 70

  if whiptail --title "Teste SMART" --yesno "Executar teste rápido (short)?" 8 50; then
    smartctl -t short "$DISK" 2>/dev/null
    msg "✅ Teste iniciado!\n\nVerifique depois com:\n  smartctl -l selftest $DISK"
  fi
}

# ── 6 ────────────────────────────────────────
temperaturas() {
  local out
  out=$(sensors 2>/dev/null) || out="lm-sensors não disponível"
  whiptail --title "$TITLE — 🌡 Temperaturas" --scrolltext --msgbox "$out" 20 70
}

# ── 7 ────────────────────────────────────────
mem_cpu() {
  local out
  out=$(echo "── MEMÓRIA ──"; free -h; echo ""; echo "── UPTIME ──"; uptime; \
        echo ""; echo "── TOP CPU ──"; ps aux --sort=-%cpu 2>/dev/null | head -6; \
        echo ""; echo "── TOP RAM ──"; ps aux --sort=-%mem 2>/dev/null | head -6)
  whiptail --title "$TITLE — 📊 Memória e CPU" --scrolltext --msgbox "$out" 24 80
}

# ── 8 ────────────────────────────────────────
logs_sistema() {
  local out
  out=$(journalctl -p 3 -b 0 --no-pager -n 50 2>/dev/null) || out="Sem acesso aos logs"
  whiptail --title "$TITLE — 📝 Logs (erros do boot)" --scrolltext --msgbox "$out" 24 80
}

# ── 9 ────────────────────────────────────────
hardware_info() {
  local out
  out=$(echo "── CPU ──"
    grep -m1 "model name" /proc/cpuinfo | cut -d: -f2
    echo "Núcleos lógicos: $(grep -c ^processor /proc/cpuinfo)"
    lscpu 2>/dev/null | grep -E "CPU max MHz|CPU min MHz|Architecture"
    echo ""
    echo "── GPU ──"
    if has nvidia-smi; then
      nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu,memory.used,memory.total \
        --format=csv,noheader
    else
      lspci | grep -iE "vga|3d|display" | cut -d: -f3-
    fi
    echo ""
    echo "── BOOT ──"
    systemd-analyze
    echo ""
    echo "Serviços mais lentos:"
    systemd-analyze blame | head -8
    echo ""
    echo "── DISPOSITIVOS ──"
    lspci | grep -iE "network|ethernet|wireless|audio|nvme|sata")
  whiptail --title "$TITLE — ⚡ Hardware" --scrolltext --msgbox "$out" 24 80
}

# ── 10 ───────────────────────────────────────
rede_menu() {
  local out
  out=$(echo "── INTERFACES ATIVAS ──"
    ip -br addr | grep -v lo
    echo ""
    echo "── PORTAS A ESCUTAR ──"
    ss -tlnp | awk 'NR>1{
      split($5,a,":"); port=a[length(a)]; print "  " port " → " $1
    }' | head -20
    echo ""
    echo "── FIREWALL ──"
    if has ufw; then ufw status | head -5
    elif has iptables; then iptables -L -n --line-numbers | head -8
    else echo "Nenhum firewall detetado"; fi
    echo ""
    echo "── DNS ──"
    resolvectl status 2>/dev/null | grep "DNS Servers" | head -1
    echo ""
    echo "── PING ──"
    echo "Cloudflare (1.1.1.1): $(ping -c 2 -W 2 1.1.1.1 2>/dev/null | awk '/rtt/{print $4}' | cut -d/ -f1) ms"
    echo "Google     (8.8.8.8): $(ping -c 2 -W 2 8.8.8.8 2>/dev/null | awk '/rtt/{print $4}' | cut -d/ -f1) ms")
  whiptail --title "$TITLE — 🌐 Rede" --scrolltext --msgbox "$out" 24 80
}

# ── 11 ───────────────────────────────────────
manutencao() {
  CHOICE=$(whiptail --title "$TITLE — 🧹 Manutenção" --menu "\nEscolha:" 16 60 6 \
    "1" "Atualizar pacotes (apt upgrade)" \
    "2" "Limpar cache do apt" \
    "3" "Limpar logs do journal (100MB)" \
    "4" "Executar TRIM no SSD" \
    "5" "Corrigir pacotes quebrados" \
    "0" "Voltar" 3>&1 1>&2 2>&3)

  case $CHOICE in
    1)
      whiptail --title "A atualizar..." --infobox "A executar apt update && apt upgrade..." 5 50
      apt-get update -qq 2>/dev/null
      apt-get upgrade -y 2>/dev/null | tail -3
      msg "✅ Atualização concluída" ;;
    2)
      apt-get autoclean -y 2>/dev/null
      apt-get autoremove -y 2>/dev/null
      msg "✅ Limpeza concluída" ;;
    3)
      journalctl --vacuum-size=100M 2>/dev/null
      msg "✅ Logs limpos (últimos 100MB mantidos)" ;;
    4)
      fstrim -v / 2>/dev/null
      msg "✅ TRIM executado" ;;
    5)
      apt-get install --fix-broken -y 2>/dev/null | tail -3
      msg "✅ Correção concluída" ;;
  esac
}

# ── 12 ───────────────────────────────────────
espaco_disco() {
  local out
  out=$(echo "── PARTIÇÕES ──"
    df -h | grep -v tmpfs | grep -v udev
    echo ""
    echo "── TOP 15 PASTAS EM $HOME ──"
    du -sh "$HOME"/* --exclude=.cache 2>/dev/null | sort -rh | head -15
    echo ""
    echo "Lixeira : $(du -sh $HOME/.local/share/Trash 2>/dev/null | awk '{print $1}')"
    echo "Cache   : $(du -sh $HOME/.cache 2>/dev/null | awk '{print $1}')")
  whiptail --title "$TITLE — 📁 Espaço em disco" --scrolltext --msgbox "$out" 24 80

  if whiptail --title "Lixeira" --yesno "Esvaziar a lixeira?" 8 50; then
    rm -rf "$HOME/.local/share/Trash"/* 2>/dev/null
    msg "✅ Lixeira vazia"
  fi
}

# ── 13 ───────────────────────────────────────
exportar_diag() {
  local out="$HOME/sysmenu-diagnostico-$(date +%Y%m%d-%H%M%S).txt"

  whiptail --title "Exportar" --infobox "A gerar diagnóstico..." 3 40

  {
    echo "══════════════════════════════════════════════════"
    echo "  🛠  SYS MENU — Diagnóstico do Sistema"
    echo "  Data: $(date)"
    echo "══════════════════════════════════════════════════"
    echo ""
    echo "Hostname : $(hostname)"
    echo "Kernel   : $(uname -r)"
    echo "OS       : $(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')"
    echo "Uptime   : $(uptime -p)"
    echo "Load     : $(cat /proc/loadavg)"
    echo ""
    echo "── CPU ──"
    grep -m1 "model name" /proc/cpuinfo | cut -d: -f2
    grep -c ^processor /proc/cpuinfo | xargs printf "Núcleos: %s\n"
    echo ""
    echo "── Memória ──"
    free -h
    echo ""
    echo "── Discos ──"
    df -h
    echo ""
    echo "── Temperaturas ──"
    sensors 2>/dev/null || echo "n/a"
    echo ""
    echo "── GPU ──"
    nvidia-smi --query-gpu=name,temperature.gpu --format=csv,noheader 2>/dev/null || \
      lspci | grep -iE "vga|3d|display" | cut -d: -f3-
    echo ""
    echo "── WiFi ──"
    iw dev "$WIFI" link 2>/dev/null || echo "n/a"
    echo ""
    echo "── Portas ──"
    ss -tlnp
    echo ""
    echo "── Serviços com falha ──"
    systemctl --failed 2>/dev/null || echo "Nenhum"
    echo ""
    echo "── Zram ──"
    zramctl 2>/dev/null || echo "Inativo"
    echo ""
    echo "── Boot ──"
    systemd-analyze
    systemd-analyze blame | head -10
    echo ""
    echo "── SMART ──"
    smartctl -H "$DISK" 2>/dev/null
    smartctl -A "$DISK" 2>/dev/null | head -45
    echo ""
    echo "── Firewall ──"
    ufw status 2>/dev/null || echo "n/a"
    echo ""
    echo "══════════════════════════════════════════════════"
    echo "  FIM"
  } > "$out"

  whiptail --title "Exportado" --msgbox "Diagnóstico salvo em:\n\n$out\n\nTamanho: $(du -h "$out" | awk '{print $1}')" 12 70
}

# ── 14 ───────────────────────────────────────
auto_pilot() {
  whiptail --title "🏁 Auto-Pilot" --yesno \
    "Vai executar:\n\n"'
• apt update & upgrade
• apt autoclean & autoremove
• Limpar logs do journal
• TRIM no SSD
• Corrigir pacotes quebrados
• Ativar zram (se inativo)
• DNS → 1.1.1.1 / 8.8.8.8
• Power saving WiFi OFF
• Esvaziar lixeira
\nDeseja continuar?' 18 60 || return

  (
    echo "XXX"; echo "A atualizar pacotes..."; echo "XXX"
    apt-get update -qq 2>/dev/null && apt-get upgrade -y 2>/dev/null
    echo "XXX"; echo "A limpar sistema..."; echo "XXX"
    apt-get autoclean -y 2>/dev/null && apt-get autoremove -y 2>/dev/null
    journalctl --vacuum-size=100M 2>/dev/null
    echo "XXX"; echo "TRIM no SSD..."; echo "XXX"
    fstrim -v / 2>/dev/null
    echo "XXX"; echo "A corrigir pacotes..."; echo "XXX"
    apt-get install --fix-broken -y 2>/dev/null
    echo "XXX"; echo "A configurar WiFi..."; echo "XXX"
    [ -n "$SSID" ] && nmcli con mod "$SSID" ipv4.dns "1.1.1.1 8.8.8.8" 2>/dev/null
    [ -n "$WIFI" ] && iw dev "$WIFI" set power_save off 2>/dev/null
    echo "XXX"; echo "A ativar zram..."; echo "XXX"
    zramctl 2>/dev/null | grep -q zram || systemctl start dev-zram0.swap 2>/dev/null
    echo "XXX"; echo "A limpar lixeira..."; echo "XXX"
    rm -rf "$HOME/.local/share/Trash"/* 2>/dev/null
    echo "XXX"; echo "Concluído!"; echo "XXX"
  ) | whiptail --title "$TITLE — 🏁 Auto-Pilot" --gauge "A executar..." 8 60 0

  msg "✅ Auto-Pilot concluído!\n\nSistema otimizado e atualizado."
}

# ── START ────────────────────────────────────
main_menu
