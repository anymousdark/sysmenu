import os, sys, subprocess, shutil, time, stat
from dataclasses import dataclass
from typing import Optional

# ── Core ─────────────────────────────────────
C = {
    'r': '\033[1;31m', 'g': '\033[1;32m', 'y': '\033[1;33m',
    'b': '\033[1;34m', 'c': '\033[1;36m', 'm': '\033[1;35m',
    'n': '\033[0m', 'B': '\033[1m', 'd': '\033[2m',
}

USER_HOME = os.path.expanduser("~")
WIFI_IFACE = ""
SSID = ""
DISK = "/dev/sda"

# ── Distro detection ─────────────────────────
@dataclass
class Distro:
    id: str
    name: str
    pkg: str
    pkg_install: str
    pkg_update: str
    pkg_upgrade: str
    pkg_clean: str
    pkg_search: str
    svc_cmd: str

DISTROS = {
    'debian': Distro('debian', 'Debian/Ubuntu', 'apt-get',
        'apt-get install -y', 'apt-get update -qq',
        'apt-get upgrade -y', 'apt-get autoclean -y && apt-get autoremove -y',
        'apt-cache search', 'systemctl'),
    'ubuntu': Distro('ubuntu', 'Ubuntu', 'apt-get',
        'apt-get install -y', 'apt-get update -qq',
        'apt-get upgrade -y', 'apt-get autoclean -y && apt-get autoremove -y',
        'apt-cache search', 'systemctl'),
    'fedora': Distro('fedora', 'Fedora', 'dnf',
        'dnf install -y', 'dnf check-update -q',
        'dnf upgrade -y', 'dnf autoremove -y',
        'dnf search', 'systemctl'),
    'rhel': Distro('rhel', 'RHEL/CentOS', 'dnf',
        'dnf install -y', 'dnf check-update -q',
        'dnf upgrade -y', 'dnf autoremove -y',
        'dnf search', 'systemctl'),
    'arch': Distro('arch', 'Arch Linux', 'pacman',
        'pacman -S --noconfirm', 'pacman -Sy',
        'pacman -Su --noconfirm', 'pacman -Sc --noconfirm',
        'pacman -Ss', 'systemctl'),
    'opensuse': Distro('opensuse', 'openSUSE', 'zypper',
        'zypper install -y', 'zypper refresh',
        'zypper update -y', 'zypper clean',
        'zypper search', 'systemctl'),
    'void': Distro('void', 'Void Linux', 'xbps-install',
        'xbps-install -y', 'xbps-install -S',
        'xbps-install -yu', 'xbps-remove -O',
        'xbps-query -Rs', 'runit'),
}

def detect_distro() -> Distro:
    try:
        with open('/etc/os-release') as f:
            data = f.read()
        for key in DISTROS:
            if f'ID={key}' in data or f'ID_LIKE={key}' in data:
                return DISTROS[key]
        if 'ID=debian' in data:
            return DISTROS['debian']
    except:
        pass
    # Fallback
    for pkgmgr, dist in [('apt-get', 'debian'), ('dnf', 'fedora'),
                           ('pacman', 'arch'), ('zypper', 'opensuse')]:
        if shutil.which(pkgmgr):
            return DISTROS[dist]
    return DISTROS['debian']

DISTRO = detect_distro()

# ── Helpers ──────────────────────────────────
def has(cmd: str) -> bool:
    return shutil.which(cmd) is not None

def run(cmd: str, as_root: bool = False, timeout: int = 120) -> str:
    if as_root and os.geteuid() != 0:
        cmd = f"sudo sh -c '{cmd}'"
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return r.stdout + r.stderr
    except:
        return ""

def pick(options: list, title: str = "") -> Optional[str]:
    """Simple picker with stdin input"""
    print(f"\n  {title}" if title else "")
    for i, (key, label) in enumerate(options, 1):
        print(f"    {C['g']}{i:2d}{C['n']})  {label}")
    print(f"    {C['r']} 0{C['n']})  Voltar")
    try:
        choice = input(f"\n  {C['B']}Opção:{C['n']} ").strip()
        idx = int(choice) - 1
        if 0 <= idx < len(options):
            return options[idx][0]
    except:
        pass
    return None

def confirm(msg: str) -> bool:
    resp = input(f"\n  {C['y']}?{C['n']} {msg} (s/N): ").strip().lower()
    return resp in ('s', 'y', 'sim', 'yes')

def show(title: str, content: str):
    """Display content with paging if long"""
    lines = content.strip().split('\n')
    print(f"\n  {C['c']}── {title} {'─' * (60 - len(title))}{C['n']}")
    for line in lines:
        print(f"  {line}")
    if len(lines) > 20:
        input(f"\n  {C['d']}Prima Enter para continuar...{C['n']}")
    else:
        print()

def section(name: str) -> str:
    return f"{'─'*4}  {name}"

def header(title: str):
    os.system('clear')
    print(f"\n  {C['c']}┌──────────────────────────────────────────────┐{C['n']}")
    print(f"  {C['c']}│{C['n']}          {C['B']}{title}{C['n']}                   {C['c']}│{C['n']}")
    print(f"  {C['c']}└──────────────────────────────────────────────┘{C['n']}")
    print(f"  {C['d']}Distro: {DISTRO.name}  |  Kernel: {os.uname().release}{C['n']}\n")

# ── Backend shell wrappers ───────────────────
def detect_hw():
    global WIFI_IFACE, SSID, DISK
    out = run("iw dev 2>/dev/null | awk '/Interface/{print $2}'")
    WIFI_IFACE = out.strip()
    out = run("nmcli -t -f NAME con show --active 2>/dev/null | head -1")
    SSID = out.strip()
    if not os.path.exists(DISK):
        disk = run("lsblk -ndo NAME 2>/dev/null | head -1").strip()
        if disk:
            DISK = f"/dev/{disk}"

def cmd_diag() -> str:
    out = f"{section('SISTEMA')}\n"
    out += f"Hostname : {run('hostname').strip()}\n"
    out += f"Kernel   : {os.uname().release}\n"
    out += f"OS       : {run('grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d \"\\\"\"').strip()}\n"
    out += f"Uptime   : {run('uptime -p 2>/dev/null | sed \"s/up //\"').strip()}\n"
    out += f"Load     : {run('cat /proc/loadavg 2>/dev/null | cut -d\" \" -f1-3').strip()}\n\n"
    out += f"{section('CPU')}\n"
    out += run("grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2").strip() + "\n"
    out += f"Núcleos  : {run('grep -c ^processor /proc/cpuinfo 2>/dev/null').strip()}\n\n"
    out += f"{section('MEMÓRIA')}\n"
    out += run("free -h | awk 'NR==1{printf \"%-8s %8s %8s %8s\\n\",$1,$2,$3,$4} NR==2{printf \"%-8s %8s %8s %8s\\n\",$1,$2,$3,$4}'").strip() + "\n\n"
    out += f"{section('DISCO')}\n"
    out += run("df -h / 2>/dev/null | awk 'NR==2{printf \"%s — %s de %s (%s livres)\\n\",$1,$3,$2,$4}'").strip() + "\n\n"
    out += f"{section('TEMPERATURAS')}\n"
    out += run("sensors 2>/dev/null | grep -E 'Core|Package|temp1|Composite|Tctl|edge' | head -5").strip() + "\n\n"
    out += f"{section('GPU')}\n"
    if has('nvidia-smi'):
        out += run("nvidia-smi --query-gpu=name,temperature.gpu --format=csv,noheader 2>/dev/null")
    else:
        out += run("lspci 2>/dev/null | grep -iE 'vga|3d|display' | cut -d: -f3-").strip() + "\n"
    out += f"\n{section('WIFI')}\n"
    out += (run(f"iw dev {WIFI_IFACE} link 2>/dev/null") if WIFI_IFACE else "(sem WiFi)\n") + "\n"
    out += f"{section('PORTAS')}\n"
    out += run("ss -tlnp 2>/dev/null | awk 'NR>1{print $5, $1}' | head -12").strip() + "\n\n"
    out += f"{section('SERVIÇOS COM FALHA')}\n"
    out += run("systemctl --failed 2>/dev/null | grep 'loaded failed' || echo 'Nenhum'").strip() + "\n\n"
    out += f"{section('ZRAM')}\n"
    out += run("zramctl 2>/dev/null || echo 'Inativo'").strip() + "\n\n"
    out += f"{section('BOOT')}\n"
    out += run("systemd-analyze 2>/dev/null").strip() + "\n"
    return out

def cmd_hardware() -> str:
    out = f"{section('CPU')}\n"
    out += run("grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2").strip() + "\n"
    out += f"Núcleos: {run('grep -c ^processor /proc/cpuinfo 2>/dev/null').strip()}\n"
    out += run("lscpu 2>/dev/null | grep -E 'CPU max MHz|CPU min MHz|Architecture'").strip() + "\n\n"
    out += f"{section('GPU')}\n"
    if has('nvidia-smi'):
        out += run("nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu,memory.used,memory.total --format=csv,noheader 2>/dev/null")
    else:
        out += run("lspci 2>/dev/null | grep -iE 'vga|3d|display' | cut -d: -f3-").strip() + "\n"
    out += f"\n{section('BOOT')}\n"
    out += run("systemd-analyze 2>/dev/null").strip() + "\n"
    out += run("systemd-analyze blame 2>/dev/null | head -8").strip() + "\n"
    out += f"\n{section('DISPOSITIVOS')}\n"
    out += run("lspci 2>/dev/null | grep -iE 'network|ethernet|wireless|audio|nvme|sata' | head -8").strip()
    return out

def cmd_wifi_info() -> str:
    if not WIFI_IFACE:
        return "Sem interface WiFi"
    out = run(f"iw dev {WIFI_IFACE} link 2>/dev/null").strip() + "\n"
    out += run(f"iw dev {WIFI_IFACE} station dump 2>/dev/null | grep -E 'signal:|bitrate:|retries:|connected time:'").strip()
    return out

def cmd_wifi_dns():
    if SSID:
        run(f"nmcli con mod \"{SSID}\" ipv4.dns '1.1.1.1 8.8.8.8'")
        run(f"nmcli con down \"{SSID}\" 2>/dev/null && nmcli con up \"{SSID}\" 2>/dev/null")
        return True
    return False

def cmd_wifi_powersave():
    if WIFI_IFACE:
        run(f"iw dev {WIFI_IFACE} set power_save off", as_root=True)
        return True
    return False

def cmd_zram_status() -> str:
    return run("zramctl 2>/dev/null; echo ''; swapon --show 2>/dev/null").strip()

def cmd_zram_activate():
    if DISTRO.svc_cmd == 'systemctl':
        run("systemctl start dev-zram0.swap", as_root=True)
    return 'zram' in run("zramctl 2>/dev/null")

def cmd_smart() -> str:
    model = run(f"smartctl -i {DISK} 2>/dev/null | grep 'Device Model' | cut -d: -f2 | xargs").strip()
    health = run(f"smartctl -H {DISK} 2>/dev/null | grep 'SMART overall-health' | cut -d: -f2 | xargs").strip()
    temp = run(f"smartctl -A {DISK} 2>/dev/null | awk '/Temperature_Celsius/{{print $10}}'").strip()
    attr = run(f"smartctl -A {DISK} 2>/dev/null | sed -n '8,25p'").strip()
    return f"Modelo: {model}\nSaúde: {health}\nTemperatura: {temp or 'N/A'}°C\n\nSMART:\n{attr}"

def cmd_smart_test():
    run(f"smartctl -t short {DISK}", as_root=True)

def cmd_rede() -> str:
    out = f"{section('INTERFACES')}\n"
    out += run("ip -br addr 2>/dev/null | grep -v lo").strip() + "\n\n"
    out += f"{section('PORTAS')}\n"
    out += run("ss -tlnp 2>/dev/null | awk 'NR>1{split($5,a,\":\"); print a[length(a)]}' | sort -n | uniq | head -20").strip() + "\n\n"
    out += f"{section('FIREWALL')}\n"
    if has('ufw'):
        out += run("ufw status 2>/dev/null | head -5")
    elif has('iptables'):
        out += run("iptables -L -n --line-numbers 2>/dev/null | head -8")
    else:
        out += "Nenhum firewall detetado\n"
    out += f"\n{section('DNS')}\n"
    out += run("resolvectl status 2>/dev/null | grep 'DNS Servers' | head -1").strip() + "\n"
    out += f"\n{section('PING')}\n"
    out += run("ping -c 2 -W 2 1.1.1.1 2>/dev/null | awk '/rtt/{print \"Cloudflare: \" $4}' | cut -d/ -f1").strip() + "\n"
    out += run("ping -c 2 -W 2 8.8.8.8 2>/dev/null | awk '/rtt/{print \"Google: \" $4}' | cut -d/ -f1").strip()
    return out

def cmd_espaco() -> str:
    out = f"{section('PARTIÇÕES')}\n"
    out += run("df -h 2>/dev/null | grep -v tmpfs | grep -v udev").strip() + "\n\n"
    out += f"{section('TOP 15 PASTAS')}\n"
    out += run(f"du -sh {USER_HOME}/* --exclude=.cache 2>/dev/null | sort -rh | head -15").strip() + "\n\n"
    trash = run(f"du -sh {USER_HOME}/.local/share/Trash 2>/dev/null | awk '{{print $1}}'").strip()
    cache = run(f"du -sh {USER_HOME}/.cache 2>/dev/null | awk '{{print $1}}'").strip()
    out += f"Lixeira: {trash or '0B'}  |  Cache: {cache or '0B'}\n"
    return out

def cmd_update():
    run(DISTRO.pkg_update, as_root=True)
    run(DISTRO.pkg_upgrade, as_root=True, timeout=300)

def cmd_clean():
    run(DISTRO.pkg_clean, as_root=True)

def cmd_seguranca() -> str:
    out = f"{section('SSH FALHADOS')}\n"
    out += run("journalctl -u sshd -n 20 --no-pager 2>/dev/null | grep -i 'failed\\|invalid' | tail -10").strip() or "(sem registos)\n"
    out += f"\n{section('COMANDOS SUDO')}\n"
    out += run("journalctl -u sudo -n 15 --no-pager 2>/dev/null | tail -10").strip() or "(sem registos)\n"
    out += f"\n{section('PORTAS >10000')}\n"
    out += run("ss -tupn 2>/dev/null | awk 'NR>1 && $1~/tcp/{split($5,a,\":\"); port=a[length(a)]; if(port+0>10000) print port}' | head -15").strip() or "(nenhuma)\n"
    out += f"\n{section('ÚLTIMOS LOGINS')}\n"
    out += run("last -10 2>/dev/null | head -10").strip()
    return out

def cmd_utilizadores() -> str:
    out = f"{section('LOGADOS')}\n"
    out += run("w -h 2>/dev/null").strip() or "(n/a)\n"
    out += f"\n{section('ÚLTIMOS LOGINS')}\n"
    out += run("last -20 2>/dev/null | head -20").strip() or "(n/a)\n"
    out += f"\n{section('REBOOTS')}\n"
    out += run("last reboot -10 2>/dev/null").strip() or "(n/a)\n"
    return out

def cmd_docker() -> str:
    if not has('docker'):
        return ""
    out = f"{section('DOCKER')}\n"
    out += f"Ativos: {run('docker ps -q 2>/dev/null | wc -l').strip()}\n"
    out += f"Total:  {run('docker ps -aq 2>/dev/null | wc -l').strip()}\n"
    out += f"Imagens: {run('docker images -q 2>/dev/null | wc -l').strip()}\n"
    if int(run('docker ps -q 2>/dev/null | wc -l').strip() or '0') > 0:
        out += run("docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}' 2>/dev/null").strip() + "\n"
    return out

def cmd_flatpak() -> str:
    if not has('flatpak'):
        return ""
    out = f"{section('FLATPAK')}\n"
    out += run("flatpak list --app 2>/dev/null | awk '{print \"  \" $1}'").strip() + "\n"
    out += f"Updates: {run('flatpak remote-ls --updates 2>/dev/null | wc -l').strip()}\n"
    return out

def cmd_kernels_cleanup():
    current = run("uname -r | sed 's/-[a-z].*//'").strip()
    if DISTRO.id in ('debian', 'ubuntu'):
        run(f"dpkg -l linux-image-* 2>/dev/null | awk '/^ii/{{print $2}}' | grep -v '{current}' | tail -n +3 | xargs -r apt-get purge -y", as_root=True, timeout=180)
        run("update-grub 2>/dev/null", as_root=True)
    elif DISTRO.id == 'arch':
        run("pacman -Qdtq 2>/dev/null | xargs -r pacman -Rns --noconfirm", as_root=True)
    elif DISTRO.id in ('fedora', 'rhel'):
        run("dnf remove --oldinstallonly --setopt installonly_limit=2 -y", as_root=True)

# ── UI modules ───────────────────────────────
def module_diag():
    header("📊 Diagnóstico")
    show("Resultado", cmd_diag())

def module_hardware():
    header("⚡ Hardware")
    show("Hardware", cmd_hardware())

def module_wifi():
    if not WIFI_IFACE:
        input(f"  {C['r']}Sem interface WiFi{C['n']}\n  Enter...")
        return
    while True:
        header("📶 WiFi")
        print(f"  {C['d']}{cmd_wifi_info()}{C['n']}\n")
        opt = pick([
            ('dns', "DNS → Cloudflare/Google"),
            ('ps', "Desligar power saving"),
            ('scan', "Scan de redes"),
        ], "Otimização")
        if opt == 'dns':
            cmd_wifi_dns()
            print(f"\n  {C['g']}✅ DNS alterado{C['n']}")
        elif opt == 'ps':
            cmd_wifi_powersave()
            print(f"\n  {C['g']}✅ Power saving OFF{C['n']}")
        elif opt == 'scan':
            run("nmcli dev wifi rescan 2>/dev/null")
            print(f"  {C['g']}Scan concluído{C['n']}")
        else:
            break
        time.sleep(1)

def module_zram():
    header("💾 Zram")
    status = cmd_zram_status()
    if 'zram' in status:
        show("Status", status)
    elif confirm("Zram inativo. Ativar?"):
        if cmd_zram_activate():
            print(f"  {C['g']}✅ Zram ativado{C['n']}")
            show("Status", cmd_zram_status())
        else:
            print(f"  {C['r']}❌ Falha (systemd-zram-generator instalado?){C['n']}")

def module_smart():
    header("💽 Disco")
    show("SMART", cmd_smart())
    if confirm("Executar teste rápido (short)?"):
        cmd_smart_test()
        print(f"\n  {C['g']}✅ Teste iniciado! Verifique com: smartctl -l selftest {DISK}{C['n']}")

def module_rede():
    header("🌐 Rede")
    show("Diagnóstico", cmd_rede())

def module_espaco():
    header("📁 Espaço")
    show("Análise", cmd_espaco())
    if confirm("Esvaziar lixeira?"):
        run(f"rm -rf {USER_HOME}/.local/share/Trash/* 2>/dev/null")
        print(f"  {C['g']}✅ Lixeira vazia{C['n']}")

def module_manutencao():
    while True:
        header("🧹 Manutenção")
        opt = pick([
            ('up', "Atualizar pacotes"),
            ('clean', "Limpar cache do gestor de pacotes"),
            ('journal', "Limpar logs do journal"),
            ('trim', "TRIM no SSD"),
            ('fix', "Corrigir pacotes quebrados"),
        ], "Operações")
        if opt == 'up':
            print(f"  {C['y']}A atualizar...{C['n']}")
            cmd_update()
            print(f"  {C['g']}✅ Concluído{C['n']}")
        elif opt == 'clean':
            cmd_clean()
            print(f"  {C['g']}✅ Limpeza concluída{C['n']}")
        elif opt == 'journal':
            run("journalctl --vacuum-size=100M", as_root=True)
            print(f"  {C['g']}✅ Logs limpos (100MB){C['n']}")
        elif opt == 'trim':
            run("fstrim -v / 2>/dev/null", as_root=True)
            print(f"  {C['g']}✅ TRIM executado{C['n']}")
        elif opt == 'fix':
            if DISTRO.pkg == 'apt-get':
                run("apt-get install --fix-broken -y", as_root=True)
            elif DISTRO.pkg == 'dnf':
                run("dnf check --fix", as_root=True)
            print(f"  {C['g']}✅ Corrigido{C['n']}")
        else:
            break
        time.sleep(1.5)

def module_limpeza():
    while True:
        header("🧼 Limpeza profunda")
        opt = pick([
            ('kernels', "Remover kernels antigos"),
            ('tmp', "Limpar /tmp e /var/tmp"),
            ('cache', "Limpar cache do apt/pacman/dnf"),
            ('homecache', "Limpar ~/.cache"),
            ('logs', "Limpar logs >7 dias"),
            ('trash', "Esvaziar lixeira"),
        ], "Operações")
        if opt == 'kernels':
            cmd_kernels_cleanup()
            print(f"  {C['g']}✅ Removidos{C['n']}")
        elif opt == 'tmp':
            run("rm -rf /tmp/* /var/tmp/* 2>/dev/null", as_root=True)
            print(f"  {C['g']}✅ Limpos{C['n']}")
        elif opt == 'cache':
            run(f"{DISTRO.pkg_clean.split('&&')[0]} clean 2>/dev/null", as_root=True)
            print(f"  {C['g']}✅ Cache limpo{C['n']}")
        elif opt == 'homecache':
            run(f"rm -rf {USER_HOME}/.cache/* 2>/dev/null")
            print(f"  {C['g']}✅ ~/.cache limpo{C['n']}")
        elif opt == 'logs':
            run("journalctl --vacuum-time=7d", as_root=True)
            print(f"  {C['g']}✅ Logs >7d removidos{C['n']}")
        elif opt == 'trash':
            run(f"rm -rf {USER_HOME}/.local/share/Trash/* 2>/dev/null")
            print(f"  {C['g']}✅ Lixeira vazia{C['n']}")
        else:
            break
        time.sleep(1.5)

def module_seguranca():
    header("🔐 Segurança")
    show("Auditoria", cmd_seguranca())

def module_utilizadores():
    header("👥 Utilizadores")
    show("Informação", cmd_utilizadores())

def module_contentores():
    header("🐳 Contentores")
    out = cmd_docker() + cmd_flatpak()
    if not out.strip():
        out = "Nenhum contentor ou Flatpak detetado."
    show("Informação", out)
    if has('flatpak') and confirm("Atualizar flatpaks?"):
        run("flatpak update -y", timeout=300)
        print(f"  {C['g']}✅ Flatpaks atualizados{C['n']}")
    if has('docker') and confirm("Limpar contentores parados/imagens não usadas?"):
        run("docker container prune -f && docker image prune -f")
        print(f"  {C['g']}✅ Docker limpo{C['n']}")

def module_servicos():
    while True:
        header("🔄 Serviços")
        svc_count = run("systemctl list-units --type=service --state=running --no-pager --no-legend 2>/dev/null | wc -l").strip()
        print(f"  {C['d']}Serviços ativos: {svc_count}{C['n']}\n")
        opt = pick([
            ('list', "Listar serviços ativos"),
            ('enabled', "Listar enabled (auto-start)"),
            ('action', "Iniciar / Parar / Reiniciar"),
            ('toggle', "Ativar / Desativar (auto-start)"),
        ], "")
        if opt == 'list':
            show("Ativos", run("systemctl list-units --type=service --state=running --no-pager 2>/dev/null"))
        elif opt == 'enabled':
            show("Enabled", run("systemctl list-unit-files --type=service --state=enabled --no-pager 2>/dev/null"))
        elif opt == 'action':
            svc = input(f"\n  Nome do serviço (ex: sshd): ").strip()
            if svc:
                print(f"  1) Iniciar   2) Parar   3) Reiniciar")
                a = input(f"\n  Opção: ").strip()
                action_map = {'1': 'start', '2': 'stop', '3': 'restart'}
                if a in action_map:
                    run(f"systemctl {action_map[a]} {svc}", as_root=True)
                    print(f"  {C['g']}✅ {svc} {action_map[a]} {C['n']}")
                    time.sleep(1)
        elif opt == 'toggle':
            svc = input(f"\n  Nome do serviço: ").strip()
            if svc:
                print(f"  1) Ativar (enable)   2) Desativar (disable)")
                a = input(f"\n  Opção: ").strip()
                action_map = {'1': 'enable', '2': 'disable'}
                if a in action_map:
                    run(f"systemctl {action_map[a]} {svc}", as_root=True)
                    print(f"  {C['g']}✅ {svc} {action_map[a]}d{C['n']}")
                    time.sleep(1)
        else:
            break

def module_autopilot():
    header("🏁 Auto-Pilot")
    print(f"\n  {C['y']}Vai executar:{C['n']}")
    tasks = [
        f"• {DISTRO.pkg_update} && {DISTRO.pkg_upgrade}",
        f"• {DISTRO.pkg_clean}",
        "• Limpar logs do journal",
        "• TRIM no SSD",
        "• Remover kernels antigos",
        "• Limpar /tmp e cache",
        "• Ativar zram",
        "• DNS → 1.1.1.1 / 8.8.8.8",
        "• Power saving WiFi OFF",
        "• Esvaziar lixeira",
        "• Atualizar flatpaks",
    ]
    for t in tasks:
        print(f"     {t}")
    if not confirm("\nContinuar?"):
        return

    steps = [
        ("A atualizar pacotes...", cmd_update),
        ("A limpar sistema...", cmd_clean),
        ("A limpar logs...", lambda: run("journalctl --vacuum-size=100M", as_root=True)),
        ("TRIM no SSD...", lambda: run("fstrim -v / 2>/dev/null", as_root=True)),
        ("A remover kernels...", cmd_kernels_cleanup),
        ("A limpar temporários...", lambda: run("rm -rf /tmp/* /var/tmp/* 2>/dev/null", as_root=True)),
        ("A configurar WiFi...", lambda: (cmd_wifi_dns(), cmd_wifi_powersave())),
        ("A ativar zram...", lambda: cmd_zram_activate() if not 'zram' in run("zramctl 2>/dev/null") else None),
        ("A limpar lixeira...", lambda: run(f"rm -rf {USER_HOME}/.local/share/Trash/* 2>/dev/null")),
        ("A atualizar flatpaks...", lambda: (has('flatpak') and run("flatpak update -y", timeout=300))),
    ]
    for msg, fn in steps:
        print(f"  {C['y']}→{C['n']} {msg}")
        fn()
        time.sleep(0.3)
    print(f"\n  {C['g']}✅ Auto-Pilot concluído!{C['n']}")
    time.sleep(1)

def module_exportar():
    header("📋 Exportar")
    outfile = f"{USER_HOME}/sysmenu-diagnostico-{time.strftime('%Y%m%d-%H%M%S')}.txt"
    content = f"{'='*60}\n  🛠  SYS MENU — Diagnóstico do Sistema\n  Data: {time.strftime('%Y-%m-%d %H:%M:%S')}\n{'='*60}\n\n"
    content += cmd_diag()
    content += f"\n{cmd_smart()}\n"
    content += cmd_rede()
    with open(outfile, 'w') as f:
        f.write(content)
    size = run(f"du -h '{outfile}' | awk '{{print $1}}'").strip()
    print(f"\n  {C['g']}✅ Diagnóstico exportado:{C['n']}")
    print(f"     {C['B']}{outfile}{C['n']}")
    print(f"     Tamanho: {size}")
    input(f"\n  Enter...")

