    return f"─── LOGADOS ───{NL}{w}{NL}{NL}─── ÚLTIMOS LOGINS ───{NL}{l}{NL}"

def cmd_docker():
    if not has('docker'): return ""
    a = run('docker ps -q 2>/dev/null|wc -l').strip()
    t = run('docker ps -aq 2>/dev/null|wc -l').strip()
    i = run('docker images -q 2>/dev/null|wc -l').strip()
    return f"─── DOCKER ───\nAtivos: {a}  |  Total: {t}  |  Imagens: {i}\n"

def cmd_flatpak():
    if not has('flatpak'): return ""
    apps = run("flatpak list --app 2>/dev/null|awk '{print \"  \" $1}'")
    up = run('flatpak remote-ls --updates 2>/dev/null|wc -l').strip()
    return f"─── FLATPAK ───\n{apps}\nUpdates: {up}\n"

def kernels_cleanup():
    c = run("uname -r|sed 's/-[a-z].*//'").strip()
    if D.id in ('debian','ubuntu'):
        run(f"dpkg -l linux-image-* 2>/dev/null|awk '/^ii/{{print \\$2}}'|grep -v '{c}'|tail -n +3|xargs -r apt-get purge -y", root=True, t=180)
        run("update-grub 2>/dev/null", root=True)

