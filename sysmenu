# ── Tab 1: Dashboard ─────────────────────────
def dashboard():
    header()
    # CPU
    cpu = run("grep -m1 'model name' /proc/cpuinfo | cut -d: -f2").strip()[:50]
    cores = run("grep -c ^processor /proc/cpuinfo").strip()
    load = run("cat /proc/loadavg | cut -d' ' -f1-3").strip()

    # Mem
    mem = run("free -h | awk 'NR==2{print $3\"/\"$2}'").strip()
    mem_pct = run("free | awk 'NR==2{printf \"%.0f\", $3/$2*100}'").strip()

    # Disk
    disk_u = run("df -h / | awk 'NR==2{print $3}'").strip()
    disk_t = run("df -h / | awk 'NR==2{print $2}'").strip()
    disk_p = run("df -h / | awk 'NR==2{print $5}'").strip()

    # Temp
    temp = run("sensors 2>/dev/null | grep -m1 'Package id 0' | awk '{print $4}' | tr -d '+' || echo '—'").strip()
    uptime = run("uptime -p | sed 's/up //'").strip()

    # WiFi
    wifi_s = ""
    if WIFI:
        s = run(f"iw dev {WIFI} station dump 2>/dev/null | awk '/signal:/{{print $2}}'").strip()
        wifi_s = f"{s} dBm" if s else "—"

    # Services failed
    failed = run("systemctl --failed 2>/dev/null | grep -c 'loaded failed' || echo 0").strip()
    failed_s = f"{C['r']}{failed} falha(s){C['n']}" if failed!='0' else f"{C['g']}0{C['n']}"

    # Zram
    zram_s = run("zramctl 2>/dev/null | awk 'NR>1{print $4}'").strip() or "Inativo"

    # Box drawing
    def box(title, *lines):
        w = 52
        print(f"  ┌─ {C['B']}{title}{C['n']} {'─'*(w-len(title)-4)}┐")
        for l in lines: print(f"  │ {l}{' '*(w-len(str(l))-2)}│")
        print(f"  └{'─'*w}┘")

    box("💻  SISTEMA",
        f"  {C['d']}CPU   {C['n']}{cpu} ({cores} núcleos)",
        f"  {C['d']}Load  {C['n']}{load}",
        f"  {C['d']}Uptime{C['n']}  {uptime}")

    box("📊  RECURSOS",
        f"  {C['d']}RAM   {C['n']}{mem}  {barra(mem_pct)} {mem_pct}%",
        f"  {C['d']}Disco {C['n']}{disk_u}/{disk_t}  {barra(disk_p.replace('%',''))} {disk_p}",
        f"  {C['d']}Temp  {C['n']}{temp}")

    boot_t = run("systemd-analyze 2>/dev/null | awk '/userspace/{print $NF}' | tr -d 's' || echo '—'").strip()
    box("🌐  REDE  ·  💾  ARMAZENAMENTO",
        f"  {C['d']}WiFi  {C['n']}{wifi_s or '—'}    {'  ' if WIFI else ''}{C['d']}Rede:{C['n']} {SSID or '—'}",
        f"  {C['d']}Zram  {C['n']}{zram_s}     {C['d']}Swap:{C['n']} {run('swapon --show 2>/dev/null | wc -l').strip()} dispositivos",
        f"  {C['d']}Svcs  {C['n']}{failed_s}                {C['d']}Boot:{C['n']} {boot_t}s")

    print(f"\n  {C['d']}Pressiona 2 para ir às ações, 3 para ver output, 0 para sair{C['n']}\n")
    navegar()

def barra(p):
    try: p=int(float(p))
    except: return ""
    n = p//10
    c = C['g'] if p<50 else C['y'] if p<80 else C['r']
    return f"{c}{'█'*n}{'░'*(10-n)}{C['n']}"

