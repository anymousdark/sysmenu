                    set_output(f"{s} {m[a]}")
                    print(f"  {C['g']}✅ {s} {m[a]}ed{C['n']}")
        elif opt=='d':
            s = input(f"\n  Serviço: ").strip()
            if s:
                a = input(f"  [1]Ativar [2]Desativar: ").strip()
                m = {'1':'enable','2':'disable'}
                if a in m:
                    run(f"systemctl {m[a]} {s}", root=True)
                    set_output(f"{s} {m[a]}d")
                    print(f"  {C['g']}✅ {s} {m[a]}d{C['n']}")
