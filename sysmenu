import os, sys, subprocess, shutil, time

C = {
    'r': '\033[1;31m', 'g': '\033[1;32m', 'y': '\033[1;33m',
    'b': '\033[1;34m', 'c': '\033[1;36m', 'm': '\033[1;35m',
    'n': '\033[0m', 'B': '\033[1m', 'd': '\033[2m',
}
HOME = os.path.expanduser("~")
WIFI = ""; SSID = ""; DISK = "/dev/sda"

# ── Distro ───────────────────────────────────
class D: pass
def detect():
    try:
        d = open('/etc/os-release').read()
        if 'ID=debian' in d or 'ID_LIKE=debian' in d: D.id='debian'; D.pkg='apt-get'; D.pi='apt-get install -y'; D.pu='apt-get update -qq'; D.pup='apt-get upgrade -y'; D.pc='apt-get autoclean -y && apt-get autoremove -y'
        elif 'ID=fedora' in d or 'ID_LIKE=fedora' in d: D.id='fedora'; D.pkg='dnf'; D.pi='dnf install -y'; D.pu='dnf check-update -q'; D.pup='dnf upgrade -y'; D.pc='dnf autoremove -y'
        elif 'ID=arch' in d: D.id='arch'; D.pkg='pacman'; D.pi='pacman -S --noconfirm'; D.pu='pacman -Sy'; D.pup='pacman -Su --noconfirm'; D.pc='pacman -Sc --noconfirm'
        elif 'ID=opensuse' in d: D.id='opensuse'; D.pkg='zypper'; D.pi='zypper install -y'; D.pu='zypper refresh'; D.pup='zypper update -y'; D.pc='zypper clean'
        else: raise ValueError()
    except:
        for p,i in [('apt-get','debian'),('dnf','fedora'),('pacman','arch'),('zypper','opensuse')]:
            if shutil.which(p): D.id=i; break
    # set defaults based on id
    if not hasattr(D,'id'): D.id='debian'
    if not hasattr(D,'pkg'):
        m = {'debian':('apt-get','apt-get install -y','apt-get update -qq','apt-get upgrade -y','apt-get autoclean -y && apt-get autoremove -y'),
             'fedora':('dnf','dnf install -y','dnf check-update -q','dnf upgrade -y','dnf autoremove -y'),
             'arch':('pacman','pacman -S --noconfirm','pacman -Sy','pacman -Su --noconfirm','pacman -Sc --noconfirm'),
             'opensuse':('zypper','zypper install -y','zypper refresh','zypper update -y','zypper clean')}
        D.pkg,D.pi,D.pu,D.pup,D.pc = m.get(D.id, m['debian'])
detect()

def has(c): return shutil.which(c) is not None

def run(cmd, root=False, t=120, nowait=False):
    if root and os.geteuid()!=0: cmd = f"sudo sh -c '{cmd}'"
    if root and not nowait: wait_apt()
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t).stdout + subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t).stderr
    except: return ""

def wait_apt():
    if D.pkg != 'apt-get': return
    for _ in range(30):
        l = run("lsof -t /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock 2>/dev/null | head -3").strip()
        if not l: return
        pids = l.split()
        proc = run(f"ps -p {','.join(pids)} -o pid=,args= 2>/dev/null").strip()
        print(f"\n  {C['y']}⏳ Lock apt: PID {proc}{C['n']}")
        if confirm("Matar processo?"):
            for p in pids: run(f"kill -9 {p} 2>/dev/null", root=True, nowait=True); time.sleep(0.5)
            run("rm -f /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock 2>/dev/null", root=True, nowait=True)
            return
        time.sleep(2)
    print(f"  {C['r']}✗ Lock apt não libertado{C['n']}")

def run_live(cmd, root=False):
    if root and os.geteuid()!=0: cmd = f"sudo sh -c '{cmd}'"
    if root: wait_apt()
    try:
        p = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for l in p.stdout: print(f"  {l}", end='', flush=True)
        p.wait()
    except: pass

def hw():
    global WIFI, SSID, DISK
    WIFI = run("iw dev 2>/dev/null | awk '/Interface/{print $2}'").strip()
    SSID = run("nmcli -t -f NAME con show --active 2>/dev/null | head -1").strip()
    if not os.path.exists(DISK):
        d = run("lsblk -ndo NAME 2>/dev/null | head -1").strip()
        if d: DISK = f"/dev/{d}"

def clear(): os.system('clear')

# ── UI ───────────────────────────────────────
def show_menu(title, items):
    clear()
    print(f"\n  {C['c']}┌─ {C['B']}{title}{C['c']} {'─'*(48-len(title))}┐{C['n']}")
    for k, v in items:
        lbl = v['label']
        if 'cat' in v:
            print(f"  {C['c']}│{C['n']}  {C['B']}{k}{C['n']})  {C['c']}{lbl}{C['n']}{' '*(38-len(lbl))}{C['c']}│{C['n']}")
        else:
            print(f"  {C['c']}│{C['n']}  {C['g']}{k}{C['n']})  {lbl}{' '*(42-len(lbl))}{C['c']}│{C['n']}")
    print(f"  {C['c']}│{C['n']}  {C['r']}0{C['n']})  Sair{' '*36}{C['c']}│{C['n']}" if title=='PRINCIPAL' else f"  {C['c']}│{C['n']}  {C['r']}0{C['n']})  Voltar{' '*34}{C['c']}│{C['n']}")
    print(f"  {C['c']}└{'─'*50}┘{C['n']}")
    try: c = input(f"\n  {C['B']}Opção:{C['n']} ").strip()
    except: c = '0'
    return c

def msg(t):
    print(f"\n  {C['y']}{t}{C['n']}")
    input(f"\n  {C['d']}Enter...{C['n']}")

def confirm(t):
    return input(f"\n  {C['y']}?{C['n']} {t} (s/N): ").strip().lower() in ('s','y')

def show_output(title, out, raw=False):
    clear()
    print(f"\n  {C['c']}┌─ {C['B']}{title}{C['c']} {'─'*(48-len(title))}┐{C['n']}")
    lines = out.split('\n')
    for l in lines[:40]:
        print(f"  {C['c']}│{C['n']} {l}")
    if len(lines) > 40:
        print(f"  {C['c']}│{C['n']}  {C['d']}... (+{len(lines)-40} linhas){C['n']}")
    print(f"  {C['c']}└{'─'*50}┘{C['n']}")
    input(f"\n  {C['d']}Enter...{C['n']}")

def run_action(title, cmd, root=False, live=False):
    clear()
    print(f"\n  {C['y']}→ {title}...{C['n']}\n")
    if live: run_live(cmd, root)
    else: run(cmd, root)
    print(f"\n  {C['g']}✅ Concluído{C['n']}")
    input()

def _r(c): return run(c)

def cmd_diag():
    NL = "\n"
    host = run('hostname').strip()
    krn = os.uname().release
    os_ = run("grep PRETTY_NAME /etc/os-release|cut -d= -f2|tr -d '\"'").strip()
    upt = run("uptime -p|sed 's/up //'").strip()
    load = run("cat /proc/loadavg|cut -d' ' -f1-3").strip()
    cpu_m = run("grep -m1 'model name' /proc/cpuinfo|cut -d: -f2").strip()
    cpu_n = run('grep -c ^processor /proc/cpuinfo').strip()
    mem = run('free -h').strip()
    disk = run("df -h /|tail -1|awk '{printf \"%s - %s de %s (%s livres)\",$1,$3,$2,$4}'")
    temp = run("sensors 2>/dev/null|grep -E 'Core|Package|temp1|Tctl'|head -5").strip()
    g = run('nvidia-smi --query-gpu=name,temperature.gpu --format=csv,noheader 2>/dev/null') if has('nvidia-smi') else run("lspci|grep -iE 'vga|3d|display'|cut -d: -f3-")
    wifi = run(f'iw dev {WIFI} link 2>/dev/null') if WIFI else '(sem WiFi)'
    portas = run("ss -tlnp|awk 'NR>1{print $5, $1}'|head -12")
    svcs = run("systemctl --failed|grep 'loaded failed'||echo 'Nenhum'")
    zram = run('zramctl 2>/dev/null||echo inativo')
    boot = run('systemd-analyze 2>/dev/null').strip()
    o = f"─── SISTEMA ───{NL}Hostname: {host}  |  Kernel: {krn}{NL}"
    o += f"OS: {os_}  |  Uptime: {upt}{NL}Load: {load}{NL}"
    o += f"{NL}─── CPU ───{NL}  {cpu_m} ({cpu_n} sockets){NL}"
    o += f"{NL}─── MEMÓRIA ───{NL}{mem}{NL}"
    o += f"{NL}─── DISCO ───{NL}{disk}{NL}"
    o += f"{NL}─── TEMPERATURAS ───{NL}{temp}{NL}"
    o += f"{NL}─── GPU ───{NL}{g.strip()}{NL}"
    o += f"{NL}─── WIFI ───{NL}{wifi}{NL}"
    o += f"{NL}─── PORTAS ───{NL}{portas}{NL}"
    o += f"{NL}─── SERVIÇOS ───{NL}{svcs}{NL}"
    o += f"{NL}─── ZRAM ───{NL}{zram}{NL}"
    o += f"{NL}─── BOOT ───{NL}{boot}{NL}"
    return o

def cmd_smart():
    if not has('smartctl'): return "smartctl não instalado"
    m = run(f"smartctl -i {DISK} 2>/dev/null|grep 'Device Model'|cut -d: -f2|xargs").strip()
    h = run(f"smartctl -H {DISK} 2>/dev/null|grep 'SMART overall-health'|cut -d: -f2|xargs").strip()
    t = run(f"smartctl -A {DISK} 2>/dev/null|awk '/Temperature_Celsius/{{print $10}}'").strip()
    a = run(f"smartctl -A {DISK} 2>/dev/null|sed -n '8,25p'").strip()
    return f"Modelo: {m}\nSaúde: {h}\nTemperatura: {t or 'N/A'}°C\n\nSMART:\n{a}"

def cmd_rede():
    NL = "\n"
    ifaces = run('ip -br addr|grep -v lo')
    portas = run("ss -tlnp|awk 'NR>1{split($5,a,\":\"); print a[length(a)]}'|sort -n|uniq|head -20")
    fw = run('ufw status|head -5 2>/dev/null||echo n/a')
    c1 = run("ping -c2 -W2 1.1.1.1 2>/dev/null|awk '/rtt/{print $4}'|cut -d/ -f1").strip() or "—"
    c2 = run("ping -c2 -W2 8.8.8.8 2>/dev/null|awk '/rtt/{print $4}'|cut -d/ -f1").strip() or "—"
    o = f"─── INTERFACES ───{NL}{ifaces}{NL}"
    o += f"{NL}─── PORTAS ───{NL}{portas}{NL}"
    o += f"{NL}─── FIREWALL ───{NL}{fw}{NL}"
    o += f"{NL}─── PING ───{NL}Cloudflare: {c1} ms{NL}Google: {c2} ms{NL}"
    return o

def cmd_espaco():
    NL = "\n"
    df = run('df -h|grep -v tmpfs|grep -v udev')
    du = run(f'du -sh {HOME}/* --exclude=.cache 2>/dev/null|sort -rh|head -15')
    return f"─── PARTIÇÕES ───{NL}{df}{NL}{NL}─── TOP 15 PASTAS ───{NL}{du}{NL}"

def cmd_seguranca():
    NL = "\n"
    s1 = run("journalctl -u sshd -n20 --no-pager 2>/dev/null|grep -i 'failed\\|invalid'|tail -10") or "(sem registos)"
    s2 = run('journalctl -u sudo -n15 --no-pager 2>/dev/null|tail -10') or "(sem registos)"
    s3 = run('last -10 2>/dev/null|head -10') or '(n/a)'
    return f"─── SSH FALHADOS ───{NL}{s1}{NL}{NL}─── SUDO ───{NL}{s2}{NL}{NL}─── LOGINS ───{NL}{s3}{NL}"

def cmd_utilizadores():
    w = run('w -h 2>/dev/null') or '(n/a)'
    l = run('last -20 2>/dev/null|head -20') or '(n/a)'
    return f"─── LOGADOS ───\n{w}\n\n─── ÚLTIMOS LOGINS ───\n{l}\n"

def cmd_docker():
    if not has('docker'): return ""
    return f"─── DOCKER ───\nAtivos: {run('docker ps -q 2>/dev/null|wc -l').strip()}  |  Total: {run('docker ps -aq 2>/dev/null|wc -l').strip()}  |  Imagens: {run('docker images -q 2>/dev/null|wc -l').strip()}\n"

def cmd_flatpak():
    if not has('flatpak'): return ""
    fl = run("flatpak list --app 2>/dev/null").strip()
    up = run('flatpak remote-ls --updates 2>/dev/null|wc -l').strip()
    return f"─── FLATPAK ───\n{fl}\nUpdates: {up}\n"

def kernels_cleanup():
    c = run("uname -r|sed 's/-[a-z].*//'").strip()
    if D.id in ('debian','ubuntu'):
        run(f"dpkg -l linux-image-* 2>/dev/null|awk '/^ii/{{print $2}}'|grep -v '{c}'|tail -n +3|xargs -r apt-get purge -y", root=True, t=180)
        run("update-grub 2>/dev/null", root=True)

# ── Menu tree ────────────────────────────────
def main():
    if os.geteuid() != 0:
        sp = os.path.abspath(sys.argv[0])
        tp = "/usr/local/bin/sysmenu"
        if not (sp==tp or (os.path.exists(tp) and os.path.samefile(sp,tp)) or shutil.which("sysmenu")):
            print(f"\n  {C['y']}⚠  sysmenu não instalado.{C['n']}")
            if input("  Instalar? (s/N): ").strip().lower() in ('s','y'):
                import getpass
                p = getpass.getpass("  Password: ")
                os.system(f"echo '{p}' | sudo -S cp '{sp}' {tp} && sudo chmod +x {tp}")
                print(f"  {C['g']}✅ Instalado! Executa: sysmenu{C['n']}")
        os.execvp('sudo', ['sudo', sys.executable] + sys.argv)
    else:
        sp = os.path.abspath(sys.argv[0])
        if sp != "/usr/local/bin/sysmenu":
            try: subprocess.run(f"cp '{sp}' /usr/local/bin/sysmenu && chmod +x /usr/local/bin/sysmenu", shell=True)
            except: pass
        hw()
        if not has('smartctl') and confirm("smartmontools não instalado. Instalar?"):
            run(f"{D.pi} smartmontools", root=True)
        principal()

