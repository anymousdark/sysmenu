        input("  Enter...")

def acao_autopilot():
    header()
    print(f"  {C['B']}🏁  Auto-Pilot{C['n']}\n")
    if not confirm("Executar tudo?"): return
    for msg, fn in [
        ("📦  Atualizar pacotes...", lambda: run_live(f"{D.pu} && {D.pup}", root=True)),
        ("🧽  Limpar cache...", lambda: run_live(D.pc, root=True)),
        ("📜  Limpar logs...", lambda: run_live("journalctl --vacuum-size=100M", root=True)),
        ("💾  TRIM...", lambda: run_live("fstrim -v /", root=True)),
        ("🗑  Kernels antigos...", kernels_cleanup),
        ("🧹  Temporários...", lambda: run("rm -rf /tmp/* /var/tmp/* 2>/dev/null", root=True)),
        ("💾  Zram...", lambda: (WIFI and run(f"iw dev {WIFI} set power_save off", root=True))),
        ("🌐  DNS...", lambda: (SSID and run(f"nmcli con mod \"{SSID}\" ipv4.dns '1.1.1.1 8.8.8.8'"))),
        ("📦  Flatpak...", lambda: (has('flatpak') and run("flatpak update -y", t=300))),
    ]:
        print(f"  {C['y']}→{C['n']} {msg}")
        fn(); time.sleep(0.2)
    set_output("Auto-Pilot concluído")
    print(f"\n  {C['g']}✅ Auto-Pilot concluído!{C['n']}")
    input()

