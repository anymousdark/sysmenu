# ── Helper ────────────────────────────────────
kernels_cleanup() {
  local curr keep=2 count
  curr=$(uname -r | sed 's/-[a-z].*//')
  count=$(dpkg -l linux-image-* 2>/dev/null | awk '/^ii/{print $2}' | wc -l)
  [ "$count" -le "$keep" ] && return
  dpkg -l linux-image-* 2>/dev/null | awk '/^ii/{print $2}' | \
    grep -v "$curr" | head -n -"$keep" | xargs -r apt-get purge -y 2>/dev/null
  update-grub 2>/dev/null
}

# ── 15 ───────────────────────────────────────
seguranca() {
  local out
  out=$(echo "────  LOGINS SSH FALHADOS  ────"
    if [ -f /var/log/auth.log ]; then
      grep "Failed password" /var/log/auth.log 2>/dev/null | tail -10
    elif [ -f /var/log/secure ]; then
      grep "Failed password" /var/log/secure 2>/dev/null | tail -10
    else
      journalctl -u sshd -n 20 --no-pager 2>/dev/null | grep -i "failed\|invalid" | tail -10
    fi
    echo ""
    echo "────  ÚLTIMOS LOGINS VIA SUDO  ────"
    journalctl -u sudo -n 15 --no-pager 2>/dev/null | tail -10
    echo ""
    echo "────  UTILIZADORES LOGADOS  ────"
    w -h
    echo ""
    echo "────  PORTAS ABERTAS (todas)  ────"
    ss -tupn 2>/dev/null | awk 'NR>1 && $1 ~ /tcp/{
      split($5,a,":"); port=a[length(a)];
      if(port !~ /^[0-9]+$/) next;
      if(port>1024 && port<10000) next;
      print port, $1, $6
    }' | head -15
    echo ""
    echo "────  ÚLTIMAS TENTATIVAS DE LOGIN  ────"
    last -10 2>/dev/null | head -10)
  whiptail --title "$TITLE — 🔐 Segurança" --scrolltext --msgbox "$out" 24 80
}

# ── 16 ───────────────────────────────────────
contentores() {
  local out=""
  if has docker; then
    out+=$(echo "────  DOCKER  ────"
      echo "Serviço: $(systemctl is-active docker 2>/dev/null)"
      echo "Contentores ativos: $(docker ps -q 2>/dev/null | wc -l)"
      echo "Contentores totais: $(docker ps -aq 2>/dev/null | wc -l)"
      echo "Imagens: $(docker images -q 2>/dev/null | wc -l)"
      [ "$(docker ps -q 2>/dev/null | wc -l)" -gt 0 ] && \
        { echo ""; docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}" 2>/dev/null; }
      echo "")
  fi
  if has flatpak; then
    out+=$(echo "────  FLATPAK  ────"
      echo "Aplicações instaladas:"
      flatpak list --app 2>/dev/null | awk '{print "  " $1}'
      echo ""
      UPD=$(flatpak update --app 2>/dev/null | grep -c "id.")
      echo "Atualizações disponíveis: $UPD")
  fi
  if [ -z "$out" ]; then
    out="Nenhum contentor (Docker) ou Flatpak detetado."
  fi
  whiptail --title "$TITLE — 🐳 Contentores" --scrolltext --msgbox "$out" 24 70

  if has flatpak; then
    if whiptail --title "Flatpak" --yesno "Atualizar todos os flatpaks?" 8 50; then
      flatpak update -y 2>/dev/null
      msg "✅ Flatpaks atualizados"
    fi
  fi
  if has docker; then
    if whiptail --title "Docker" --yesno "Limpar contentores parados e imagens não usadas?" 8 60; then
      docker container prune -f 2>/dev/null
      docker image prune -f 2>/dev/null
      msg "✅ Docker limpo"
    fi
  fi
}

