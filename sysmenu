def main():
    if os.geteuid() != 0:
        os.execvp('sudo', ['sudo', sys.executable] + sys.argv)

    detect_hw()

    # Check/install smartmontools if missing
    if not has('smartctl'):
        if confirm("smartmontools não instalado. Instalar?"):
            run(f"{DISTRO.pkg_install} smartmontools", as_root=True)

    while True:
        header("🛠  Sys Menu")
        print(f"  {C['B']}Categorias:{C['n']}\n")
        print(f"    {C['g']}1{C['n']})  📊  Diagnóstico e monitoramento")
        print(f"    {C['g']}2{C['n']})  🌐  Rede e WiFi")
        print(f"    {C['g']}3{C['n']})  💾  Armazenamento e disco")
        print(f"    {C['g']}4{C['n']})  🧹  Manutenção e limpeza")
        print(f"    {C['g']}5{C['n']})  🔒  Segurança e utilizadores")
        print(f"    {C['g']}6{C['n']})  🐳  Extras (Docker, Flatpak, Serviços)")
        print(f"    {C['g']}7{C['n']})  📋  Exportar diagnóstico")
        print(f"    {C['r']}0{C['n']})  ❌  Sair")
        try:
            choice = input(f"\n  {C['B']}Opção:{C['n']} ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break

        branches = {
            '1': [
                ('diag', "🔍  Diagnóstico completo", module_diag),
                ('hw', "⚡  Hardware (CPU/GPU/boot)", module_hardware),
            ],
            '2': [
                ('wifi', "📶  WiFi", module_wifi),
                ('rede', "🌐  Rede (portas, firewall)", module_rede),
            ],
            '3': [
                ('zram', "💾  Zram", module_zram),
                ('disk', "💽  SMART", module_smart),
                ('space', "📁  Espaço em disco", module_espaco),
            ],
            '4': [
                ('man', "🧹  Manutenção geral", module_manutencao),
                ('deep', "🧼  Limpeza profunda", module_limpeza),
                ('svc', "🔄  Gestão de serviços", module_servicos),
                ('auto', "🏁  Auto-Pilot", module_autopilot),
            ],
            '5': [
                ('sec', "🔐  Segurança", module_seguranca),
                ('users', "👥  Utilizadores", module_utilizadores),
            ],
            '6': [
                ('containers', "🐳  Docker / Flatpak", module_contentores),
            ],
            '7': [('export', "📋  Exportar diagnóstico", module_exportar)],
        }

        if choice == '0' or choice == '':
            print(f"\n  {C['g']}Bye!{C['n']}")
            break

        if choice in branches:
            while True:
                header("Submenu")
                items = branches[choice]
                sub_opts = [(f'{k}', f'{lbl}') for k, lbl, _ in items]
                sel = pick(sub_opts, "Escolha:")
                if sel is None:
                    break
                for k, _, fn in items:
                    if sel == k:
                        fn()
        else:
            print(f"\n  {C['r']}Opção inválida{C['n']}")
            time.sleep(1)

if __name__ == '__main__':
    if os.geteuid() != 0:
        # Check if installed globally; if not, offer to install
        sp = os.path.abspath(sys.argv[0])
        tp = "/usr/local/bin/sysmenu"
        if not (sp == tp or (os.path.exists(tp) and os.path.samefile(sp, tp)) or shutil.which("sysmenu")):
            print(f"\n  {C['y']}⚠  sysmenu não está instalado globalmente.{C['n']}")
            print(f"     A executar de: {C['B']}{sp}{C['n']}")
            resp = input(f"  {C['y']}?{C['n']} Instalar em /usr/local/bin? (s/N): ").strip().lower()
            if resp in ('s', 'y', 'sim', 'yes'):
                import getpass
                pwd = getpass.getpass(f"  {C['d']}Password sudo:{C['n']} ")
                r = os.system(f"echo '{pwd}' | sudo -S cp '{sp}' /usr/local/bin/sysmenu 2>/dev/null && sudo chmod +x /usr/local/bin/sysmenu")
                if r == 0:
                    print(f"\n  {C['g']}✅ Instalado! Agora executa: sysmenu{C['n']}\n")
                else:
                    print(f"\n  {C['r']}❌ Erro. Tenta: sudo cp sysmenu /usr/local/bin/{C['n']}\n")
        os.execvp('sudo', ['sudo', sys.executable] + sys.argv)
    else:
        # Running as root — auto-install if from source
        sp = os.path.abspath(sys.argv[0])
        tp = "/usr/local/bin/sysmenu"
        if sp != tp and not (os.path.exists(tp) and os.path.samefile(sp, tp)):
            try:
                subprocess.run(f"cp '{sp}' {tp} && chmod +x {tp}", shell=True, check=True)
            except:
                pass
        main()
