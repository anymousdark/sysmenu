def navegar():
    global TAB
    try:
        c = input("").strip()
        if c == '0': sys.exit(0)
        elif c in ('1','2','3'): TAB = int(c); {1:dashboard,2:acoes,3:output_view}[TAB]()
        else: navegar()
    except: sys.exit(0)

def main():
    if os.geteuid() != 0:
        sp = os.path.abspath(sys.argv[0])
        tp = "/usr/local/bin/sysmenu"
        if not (sp==tp or (os.path.exists(tp) and os.path.samefile(sp,tp)) or shutil.which("sysmenu")):
            print(f"\n  {C['y']}⚠  sysmenu não instalado globalmente.{C['n']}")
            if input("  Instalar? (s/N): ").strip().lower() in ('s','y'):
                import getpass
                p = getpass.getpass("  Password sudo: ")
                os.system(f"echo '{p}' | sudo -S cp '{sp}' /usr/local/bin/sysmenu && sudo chmod +x /usr/local/bin/sysmenu")
                print(f"  {C['g']}✅ Instalado! Executa: sysmenu{C['n']}\n")
        os.execvp('sudo', ['sudo', sys.executable] + sys.argv)
    else:
        sp = os.path.abspath(sys.argv[0])
        tp = "/usr/local/bin/sysmenu"
        if sp != tp and not (os.path.exists(tp) and os.path.samefile(sp,tp)):
            try: subprocess.run(f"cp '{sp}' {tp} && chmod +x {tp}", shell=True)
            except: pass
        detect_hw()
        if not has('smartctl') and confirm("smartmontools não instalado. Instalar?"):
            run(f"{D.pi} smartmontools", root=True)
        dashboard()

if __name__ == '__main__':
    main()
