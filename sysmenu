    "5" "Limpar logs do journal (mínimo)" \
    "6" "Esvaziar lixeira" \
    "0" "Voltar" 3>&1 1>&2 2>&3)

  case $CHOICE in
    1) kernels_cleanup
       msg "✅ Kernels antigos removidos" ;;
    2) rm -rf /tmp/* /var/tmp/* 2>/dev/null
       msg "✅ /tmp e /var/tmp limpos" ;;
    3) apt-get clean -y 2>/dev/null
       msg "✅ Cache do apt limpo" ;;
    4) rm -rf "$HOME/.cache/"* 2>/dev/null
       msg "✅ Cache de utilizador limpo" ;;
    5) journalctl --vacuum-time=7d 2>/dev/null
       msg "✅ Logs com mais de 7 dias removidos" ;;
    6) rm -rf "$HOME/.local/share/Trash"/* 2>/dev/null
       msg "✅ Lixeira vazia" ;;
  esac
}

# ── 18 ───────────────────────────────────────
utilizadores() {
  local out
  out=$(echo "────  QUEM ESTÁ LOGADO  ────"
    w -h || echo "(n/a)"
    echo ""
    echo "────  ÚLTIMOS LOGINS  ────"
    last -20 2>/dev/null || echo "(n/a)"
    echo ""
    echo "────  HISTÓRICO DE REBOOTS  ────"
    last reboot -10 2>/dev/null
    echo ""
    echo "────  CRON JOBS (utilizadores)  ────"
    for u in $(cut -d: -f1 /etc/passwd); do
      crontab -u "$u" -l 2>/dev/null | grep -v "^#" | grep -v "^$" | \
        sed "s/^/  $u: /"
    done
    echo ""
    echo "────  CRON JOBS (sistema)  ────"
    ls /etc/cron.d/ /etc/cron.hourly/ /etc/cron.daily/ 2>/dev/null | head -15 | sed 's/^/  /')
  whiptail --title "$TITLE — 👥 Utilizadores" --scrolltext --msgbox "$out" 24 80
}

# ── 19 ───────────────────────────────────────
servicos_manager() {
  while true; do
    local running
    running=$(systemctl list-units --type=service --state=running --no-pager --no-legend 2>/dev/null | \
      awk '{print $1}' | head -25 | paste -sd ' ' -)

    CHOICE=$(whiptail --title "$TITLE — 🔄 Serviços" --menu \
      "Serviços ativos:\n$running\n" 20 72 5 \
      "1" "Listar todos os serviços ativos" \
      "2" "Listar serviços enabled (auto-start)" \
      "3" "Iniciar / Parar / Reiniciar um serviço" \
      "4" "Ativar / Desativar um serviço (auto-start)" \
      "0" "Voltar" 3>&1 1>&2 2>&3)

    case $CHOICE in
      1) whiptail --title "Serviços ativos" --scrolltext \
           --msgbox "$(systemctl list-units --type=service --state=running --no-pager 2>/dev/null)" 24 80 ;;
      2) whiptail --title "Serviços enabled" --scrolltext \
           --msgbox "$(systemctl list-unit-files --type=service --state=enabled --no-pager 2>/dev/null)" 24 80 ;;
      3) local svc
         svc=$(whiptail --title "Serviço" --inputbox "Nome do serviço (ex: sshd):" 8 60 3>&1 1>&2 2>&3)
         [ -z "$svc" ] && continue
         ACTION=$(whiptail --title "$svc" --menu "O que fazer com $svc?" 12 50 3 \
           "1" "Iniciar" "2" "Parar" "3" "Reiniciar" 3>&1 1>&2 2>&3)
         case $ACTION in
           1) systemctl start "$svc" 2>/dev/null && msg "✅ $svc iniciado" || msg "❌ Falha ao iniciar $svc" ;;
           2) systemctl stop "$svc" 2>/dev/null && msg "✅ $svc parado" || msg "❌ Falha ao parar $svc" ;;
           3) systemctl restart "$svc" 2>/dev/null && msg "✅ $svc reiniciado" || msg "❌ Falha ao reiniciar $svc" ;;
         esac ;;
      4) local svc2
         svc2=$(whiptail --title "Serviço" --inputbox "Nome do serviço (ex: bluetooth):" 8 60 3>&1 1>&2 2>&3)
         [ -z "$svc2" ] && continue
         ACTION2=$(whiptail --title "$svc2" --menu "O que fazer?" 12 50 2 \
           "1" "Ativar (enable)" "2" "Desativar (disable)" 3>&1 1>&2 2>&3)
         case $ACTION2 in
           1) systemctl enable "$svc2" 2>/dev/null && msg "✅ $svc2 ativado (auto-start)" || msg "❌ Falha" ;;
           2) systemctl disable "$svc2" 2>/dev/null && msg "✅ $svc2 desativado" || msg "❌ Falha" ;;
         esac ;;
      0|"") return ;;
    esac
  done
}

