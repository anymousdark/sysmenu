# ── Distro ───────────────────────────────────
@dataclass
class Distro:
    id: str; name: str; pkg: str
    pi: str; pu: str; pup: str; pc: str; sc: str
DISTROS = {
    'debian':  Distro('debian','Debian/Ubuntu','apt-get','apt-get install -y','apt-get update -qq','apt-get upgrade -y','apt-get autoclean -y && apt-get autoremove -y','systemctl'),
    'fedora':  Distro('fedora','Fedora','dnf','dnf install -y','dnf check-update -q','dnf upgrade -y','dnf autoremove -y','systemctl'),
    'arch':    Distro('arch','Arch Linux','pacman','pacman -S --noconfirm','pacman -Sy','pacman -Su --noconfirm','pacman -Sc --noconfirm','systemctl'),
    'opensuse':Distro('opensuse','openSUSE','zypper','zypper install -y','zypper refresh','zypper update -y','zypper clean','systemctl'),
    'void':    Distro('void','Void Linux','xbps-install','xbps-install -y','xbps-install -S','xbps-install -yu','xbps-remove -O','runit'),
}
def detect_distro():
    try:
        d = open('/etc/os-release').read()
        for k in DISTROS:
            if f'ID={k}' in d or f'ID_LIKE={k}' in d:
                return DISTROS[k]
    except: pass
    for p,d in [('apt-get','debian'),('dnf','fedora'),('pacman','arch'),('zypper','opensuse')]:
        if shutil.which(p): return DISTROS[d]
    return DISTROS['debian']

D = detect_distro()
WIFI = ""; SSID = ""; DISK = "/dev/sda"
LAST_OUTPUT = ""
TAB = 1  # 1=Dashboard, 2=Ações, 3=Output

# ── Core ─────────────────────────────────────
def has(c): return shutil.which(c) is not None

def run(cmd, root=False, t=120):
    if root and os.geteuid()!=0: cmd = f"sudo sh -c '{cmd}'"
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t)
        return r.stdout + r.stderr
    except: return ""

def run_live(cmd, root=False):
    if root and os.geteuid()!=0: cmd = f"sudo sh -c '{cmd}'"
    try:
        p = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for l in p.stdout: print(f"  {l}", end='', flush=True)
        p.wait()
    except: pass

def pick(opts, title=""):
    print(f"\n  {title}")
    for i,(k,l) in enumerate(opts,1): print(f"    {C['g']}{i:2d}{C['n']})  {l}")
    print(f"    {C['r']} 0{C['n']})  Voltar")
    try:
        c = int(input(f"\n  {C['B']}»{C['n']} ").strip())-1
        if 0<=c<len(opts): return opts[c][0]
    except: pass
    return None

def confirm(m):
    return input(f"\n  {C['y']}?{C['n']} {m} (s/N): ").strip().lower() in ('s','y')

def detect_hw():
    global WIFI, SSID, DISK
    WIFI = run("iw dev 2>/dev/null | awk '/Interface/{print $2}'").strip()
    SSID = run("nmcli -t -f NAME con show --active 2>/dev/null | head -1").strip()
    if not os.path.exists(DISK):
        d = run("lsblk -ndo NAME 2>/dev/null | head -1").strip()
        if d: DISK = f"/dev/{d}"

def set_output(o):
    global LAST_OUTPUT
    LAST_OUTPUT = o

def show_output(out):
    print(out[:2500])
    if len(out) > 2500:
        print(f"\n  {C['d']}... (output truncado, ver aba 3 para completo){C['n']}")
    print(f"\n  {C['d']}[Enter] Continuar  |  [3] Ver output completo{C['n']}")
    try:
        c = input(f"\n  {C['B']}»{C['n']} ").strip()
        if c == '3':
            global TAB; TAB = 3; output_view()
    except: pass

